VITE_CROSS_SCHEMA_API_URL=https://d539yuu6hhr8z.cloudfront.net/api/cross-schema
# For Node.js scripts and tests
CROSS_SCHEMA_API_URL=https://d539yuu6hhr8z.cloudfront.net/api/cross-schema